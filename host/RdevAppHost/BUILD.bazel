load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

# The desktop app's view of the host: what the retired C ABI's `RdevHostCABI.swift` Box/E2EBox/
# AdoptBox held, as a Swift API. The native app (//app:Xpromptvs) calls it directly.
swift_library(
    name = "RdevAppHost",
    srcs = glob(["Sources/RdevAppHost/**/*.swift"]),
    module_name = "RdevAppHost",
    visibility = ["//visibility:public"],
    deps = [
        "//host/RdevCore:RdevCore",
        "//host/RdevHostKit:RdevHostKit",
    ],
)

swift_test(
    name = "RdevAppHostTests",
    srcs = glob(["Tests/RdevAppHostTests/**/*.swift"]),
    module_name = "RdevAppHostTests",
    deps = [
        ":RdevAppHost",
        "//host/RdevHostKit:RdevHostKit",
    ],
    # Second layer, not the only one: E2EHostTests.swift drives `forgetListing()` directly rather
    # than the public `forget()` specifically so this suite never reaches `E2EIdentityService` at
    # all. This redirects `RDEV_E2E_STORE` anyway, so a future test that DOES name a signalling base
    # (any call to `E2EHost.service(base:)`/`listSessions`/`forget()`) still cannot reach the real
    # `~/Library/Application Support/dev.rdev.host/` — this developer's actual keys and trust record.
    env = {"RDEV_E2E_STORE": "dev.rdev.test.rdevapphost"},
)
