load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")

cc_library(
    name = "zstd",
    srcs = glob(["lib/common/*.c", "lib/compress/*.c", "lib/decompress/*.c", "lib/**/*.h"]),
    hdrs = ["lib/zstd.h", "lib/zstd_errors.h"],
    includes = ["lib"],
    defines = ["ZSTD_DISABLE_ASM=1"],
    aspect_hints = [":interop"],
    visibility = ["//visibility:public"],
)
swift_interop_hint(name = "interop", module_name = "Zstd")
exports_files(["LICENSE", "COPYING"])
