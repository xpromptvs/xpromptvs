module(
    name = "rdev",
    version = "0.1.0",
)

bazel_dep(name = "rules_swift", version = "3.6.1")
bazel_dep(name = "rules_apple", version = "4.5.3")
bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "platforms", version = "1.1.0")

new_local_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:local.bzl",
    "new_local_repository",
)

new_local_repository(
    name = "libaom_src",
    build_file = "//third_party:libaom.BUILD.bazel",
    path = "third_party/libaom",
)

new_local_repository(
    name = "libopus_src",
    build_file = "//third_party:libopus.BUILD.bazel",
    path = "third_party/libopus",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.4")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")

go_deps.from_file(go_work = "//:go.work")
use_repo(go_deps, "com_github_pion_ice_v4", "com_github_pion_interceptor", "com_github_pion_logging", "com_github_pion_rtcp", "com_github_pion_rtp", "com_github_pion_sctp", "com_github_pion_transport_v4", "com_github_pion_webrtc_v4")

go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/pion-sctp:abandon-on-loss.patch"],
    path = "github.com/pion/sctp",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "swiftterm",
    build_file = "//third_party:swiftterm.BUILD.bazel",
    patch_args = ["-p1"],
    patches = ["//third_party/swiftterm:rdev-snapshot-access.patch"],
    sha256 = "ef95aaefdb5134cfcaced6252070e333f03411ae06ab0787ad1ff6fd0c25d423",
    strip_prefix = "SwiftTerm-1.13.0",
    url = "https://github.com/migueldeicaza/SwiftTerm/archive/refs/tags/v1.13.0.tar.gz",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2021", versions = ["1.90.0"])
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//host/rdev-noise:Cargo.lock",
    manifests = ["//host/rdev-noise:Cargo.toml"],
)
use_repo(crate, "crates")

bazel_dep(name = "googletest", version = "1.17.0", dev_dependency = True)

http_archive(
    name = "zstd",
    urls = ["https://deb.debian.org/debian/pool/main/libz/libzstd/libzstd_1.5.7+dfsg.orig.tar.xz"],
    sha256 = "0c092ef267edce57ba7f3f2645c861f72eaf5e76273c6c3632869423464b90a5",
    strip_prefix = "zstd-1.5.7",
    build_file = "//third_party:zstd.BUILD.bazel",
)
