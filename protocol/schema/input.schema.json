{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rdev/input",
  "title": "rdev input message",
  "type": "object",
  "required": ["t"],
  "oneOf": [
    {
      "properties": {
        "t": { "const": "touch" },
        "phase": { "enum": ["down", "move", "up"] },
        "id": { "type": "integer", "minimum": 0 },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "ts": { "type": "integer", "minimum": 0 }
      },
      "required": ["t", "phase", "id", "x", "y", "ts"],
      "additionalProperties": false
    },
    {
      "properties": {
        "t": { "const": "key" },
        "data": { "type": "string" },
        "term": { "type": "string", "pattern": "^(pty:[0-9]+|tmux:\\$[0-9]+)$" }
      },
      "required": ["t", "data", "term"],
      "additionalProperties": false
    },
    {
      "properties": {
        "t": { "const": "term-reply" },
        "data": { "type": "string" },
        "term": { "type": "string", "pattern": "^(pty:[0-9]+|tmux:\\$[0-9]+)$" }
      },
      "required": ["t", "data", "term"],
      "additionalProperties": false
    }
  ]
}
